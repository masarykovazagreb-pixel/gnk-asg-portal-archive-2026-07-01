{
  "schemaVersion": 4,
  "version": "2026-06-21-v4-three-daily-draft-first",
  "productionLocked": true,
  "deploymentApproved": false,
  "operatingModel": {
    "automationTargetPercent": 99,
    "topicApprovalRequired": false,
    "standardPublicationApprovalRequired": true,
    "previewMode": "draft_first",
    "manualUploadAllowedForAuthorizedUsers": true,
    "singleSharedPublicationSource": true,
    "humanReviewOnlyForSensitiveExceptions": false,
    "automaticProductionPublishingEnabled": false
  },
  "schedule": {
    "timeZone": "Europe/Zagreb",
    "localTimes": ["09:15", "13:00", "17:00"],
    "articlesPerDay": 3,
    "dailyDigestHour": 23,
    "enabledInPreview": true,
    "enabledInProduction": false,
    "deduplicateByLocalSlot": true
  },
  "publicationRoutes": {
    "sharedSource": true,
    "hrIndex": "/objave/",
    "hrArticle": "/objave/<slug>/",
    "enIndex": "/publications/",
    "enArticle": "/publications/<slug>/",
    "canonical": "/objave/<slug>/",
    "newsHr": "/vijesti/",
    "newsEn": "/news/",
    "newsSeparationRule": "Vijesti/News prikazuju vanjske aktualne izvore; Objave/Publications prikazuju vlastite tekstove GNK ASG-a."
  },
  "articleRules": {
    "minimumWordsHr": 500,
    "minimumWordsEn": 500,
    "author": "Nermin Sefić",
    "autoSelectTopic": true,
    "topicApprovalRequired": false,
    "autoPublishStandardContent": false,
    "requireHrEn": true,
    "requireImage": true,
    "requireAtLeastOneSource": true,
    "preferredSourceCount": 2,
    "requireWhyItMatters": true,
    "requireOwnConclusion": true,
    "duplicateProtection": true,
    "blockUnsupportedClaims": true,
    "primaryCategories": [
      "Poslovanje",
      "Tržišta",
      "AI i tehnologija",
      "Sport i ekonomija"
    ],
    "additionalCategories": [
      "BPP i fintech",
      "Mediji i komunikacija",
      "Korporativno upravljanje",
      "Održivost i infrastruktura"
    ]
  },
  "imageRules": {
    "catalogs": [
      "/data/visual_gallery.json",
      "/data/generated-gallery-30.json",
      "/data/auto-editor-image-catalog.json"
    ],
    "publicGallery": "https://gnk-asg.hr/visual-index/",
    "requiredStatus": "ready",
    "requiredEligibility": true,
    "selectionPriority": [
      "exact topic and keyword match",
      "primary or additional category match",
      "language-neutral editorial image",
      "least recently used image",
      "GNK ASG brand fallback"
    ],
    "preventImageReuseDays": 7,
    "verifyImageHttpStatus": true,
    "verifyMimeType": true,
    "requiredWidth": 1200,
    "preferredWidth": 2048,
    "preferredHeight": 1152,
    "preferredRatio": "16:9",
    "requiredFields": [
      "url",
      "alt",
      "title",
      "caption",
      "credit",
      "width",
      "height",
      "mimeType"
    ],
    "fallback": "https://gnk-asg.hr/assets/gnk-asg-social-card.png",
    "blockPublishWhenImageMissing": true,
    "blockPublishWhenAltMissing": true
  },
  "dailyDigestRules": {
    "minimumWordsHr": 900,
    "minimumWordsEn": 900,
    "autoPublish": false,
    "includeAllDailyPublications": true,
    "includeCommonThemes": true,
    "includeRisksAndOpportunities": true,
    "includeManagementCommentary": true,
    "includeNextDayWatchlist": true,
    "author": "Nermin Sefić"
  },
  "mailAutomation": {
    "readInboundAutomatically": true,
    "classifyAutomatically": true,
    "summarizeAutomatically": true,
    "generateContextualReply": true,
    "useFixedReplyTemplates": false,
    "autoSendLowRiskGeneralReplies": true,
    "autoAssignMailboxProfile": true,
    "autoApplyProfessionalSignature": true,
    "storeInboxOutboxSentAndHeld": true,
    "preventReplyLoops": true,
    "sensitiveCategoriesHeldForReview": [
      "legal",
      "contract",
      "financial_commitment",
      "payment_instruction",
      "complaint_or_claim",
      "personal_data_request",
      "security_incident",
      "media_statement",
      "employment",
      "government_or_court"
    ]
  },
  "seoRules": {
    "metaTitle": true,
    "metaDescription": true,
    "canonicalHr": true,
    "hreflangHrEn": true,
    "openGraph": true,
    "twitterCards": true,
    "articleSchema": true,
    "imageObjectSchema": true,
    "breadcrumbSchema": true,
    "imageAltTitleCaptionCredit": true,
    "sitemap": true,
    "imageSitemap": true,
    "maxImagePreviewLarge": true,
    "indexNowWhenConfigured": true,
    "googleIndexingThroughSitemapAndSearchConsole": true
  },
  "pdfPublicationRules": {
    "adminPath": "/pdf-publisher/",
    "publicHrCollection": "/objave/?type=pdf",
    "publicEnCollection": "/publications/?type=pdf",
    "storePdfInR2": true,
    "createDigitalDocumentSchema": true,
    "requireTitleSummaryImageAndLanguage": true,
    "draftOrPublishedStatus": true
  },
  "safetyRules": {
    "routineContentAutoPublishes": false,
    "routineGeneralMailAutoSends": true,
    "sensitiveMailNeverAutoSends": true,
    "mailSendRequiresExplicitApproval": false,
    "deployRequiresExplicitApproval": true,
    "routeChangesRequireExplicitApproval": true,
    "secretChangesRequireExplicitApproval": true,
    "deleteRequiresExplicitApproval": true,
    "financialAndLegalActionsNeverAutoExecute": true
  },
  "logging": {
    "queue": true,
    "plan": true,
    "classification": true,
    "execution": true,
    "sourceSelection": true,
    "imageSelection": true,
    "publicationResult": true,
    "mailDecision": true,
    "mailReplyResult": true,
    "indexingResult": true,
    "errors": true,
    "rollbackReference": true
  }
}
