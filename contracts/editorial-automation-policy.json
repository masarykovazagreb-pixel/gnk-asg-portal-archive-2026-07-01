{
  "schemaVersion": 2,
  "version": "2026-06-20-v2-automatic",
  "productionLocked": true,
  "deploymentApproved": false,
  "operatingModel": {
    "automationTargetPercent": 99,
    "topicApprovalRequired": false,
    "standardPublicationApprovalRequired": false,
    "manualUploadAllowedForAuthorizedUsers": true,
    "singleSharedPublicationSource": true,
    "humanReviewOnlyForSensitiveExceptions": true
  },
  "schedule": {
    "timeZone": "Europe/Zagreb",
    "articleIntervalHours": 3,
    "dailyDigestHour": 23,
    "enabledInPreview": true,
    "enabledInProduction": false
  },
  "articleRules": {
    "minimumWordsHr": 500,
    "minimumWordsEn": 500,
    "author": "Nermin Sefić",
    "autoSelectTopic": true,
    "topicApprovalRequired": false,
    "autoPublishStandardContent": true,
    "requireHrEn": true,
    "requireImage": true,
    "imageSource": "https://gnk-asg.hr/visual-index/",
    "requireAtLeastOneSource": true,
    "requireWhyItMatters": true,
    "requireOwnConclusion": true,
    "duplicateProtection": true,
    "categories": [
      "Poslovanje",
      "Tržišta",
      "AI i tehnologija",
      "Sport i ekonomija"
    ]
  },
  "dailyDigestRules": {
    "minimumWordsHr": 900,
    "minimumWordsEn": 900,
    "autoPublish": true,
    "includeAllDailyPublications": true,
    "includeCommonThemes": true,
    "includeRisksAndOpportunities": true,
    "includeManagementCommentary": true,
    "includeNextDayWatchlist": true,
    "author": "Nermin Sefić"
  },
  "mailAutomation": {
    "readInboundAutomatically": true,
    "classifyAutomatically": true,
    "summarizeAutomatically": true,
    "generateContextualReply": true,
    "useFixedReplyTemplates": false,
    "autoSendLowRiskGeneralReplies": true,
    "autoAssignMailboxProfile": true,
    "autoApplyProfessionalSignature": true,
    "storeInboxOutboxSentAndHeld": true,
    "preventReplyLoops": true,
    "sensitiveCategoriesHeldForReview": [
      "legal",
      "contract",
      "financial_commitment",
      "payment_instruction",
      "complaint_or_claim",
      "personal_data_request",
      "security_incident",
      "media_statement",
      "employment",
      "government_or_court"
    ]
  },
  "seoRules": {
    "metaTitle": true,
    "metaDescription": true,
    "canonicalHr": true,
    "hreflangHrEn": true,
    "openGraph": true,
    "twitterCards": true,
    "articleSchema": true,
    "imageObjectSchema": true,
    "imageAltTitleCaptionCredit": true,
    "sitemap": true,
    "imageSitemap": true,
    "indexNowWhenConfigured": true,
    "googleIndexingThroughSitemapAndSearchConsole": true
  },
  "safetyRules": {
    "routineContentAutoPublishes": true,
    "routineGeneralMailAutoSends": true,
    "sensitiveMailNeverAutoSends": true,
    "mailSendRequiresExplicitApproval": false,
    "deployRequiresExplicitApproval": true,
    "routeChangesRequireExplicitApproval": true,
    "secretChangesRequireExplicitApproval": true,
    "deleteRequiresExplicitApproval": true,
    "financialAndLegalActionsNeverAutoExecute": true
  },
  "logging": {
    "queue": true,
    "plan": true,
    "classification": true,
    "execution": true,
    "sourceSelection": true,
    "publicationResult": true,
    "mailDecision": true,
    "mailReplyResult": true,
    "indexingResult": true,
    "errors": true,
    "rollbackReference": true
  }
}
