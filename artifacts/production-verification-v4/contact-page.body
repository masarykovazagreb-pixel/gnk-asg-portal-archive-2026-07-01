<!doctype html><html lang="hr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Kontakt | GNK ASG d.o.o.</title><meta name="description" content="Službena kontakt forma GNK ASG d.o.o. s evidencijskim brojem i potvrdom zaprimanja."><meta name="robots" content="index,follow"><link rel="canonical" href="https://gnk-asg.hr/contact/"><link rel="alternate" hreflang="hr" href="https://gnk-asg.hr/contact/"><link rel="alternate" hreflang="en" href="https://gnk-asg.hr/en/contact/"><link rel="stylesheet" href="/assets/public-design-tokens-v1.css?v=20260713-v2-unified"><style>body{background:linear-gradient(145deg,#f7f8fb,#eef2f6);color:#0f172a}.contact-main{width:min(940px,calc(100% - 28px));margin:auto;padding:56px 0 80px}.contact-hero{display:grid;grid-template-columns:150px 1fr;gap:30px;align-items:center;margin-bottom:30px}.contact-logo{display:block;width:140px;height:145px;object-fit:contain}.contact-hero h1{margin:4px 0 10px;color:#07162d;font:800 clamp(2.4rem,6vw,4.8rem)/1.02 Georgia,serif}.contact-hero p{max-width:700px;color:#526071;font-size:1.08rem;line-height:1.7}.contact-card{padding:clamp(20px,4vw,38px);border:1px solid rgba(184,138,47,.34);border-radius:24px;background:#fff;box-shadow:0 18px 48px rgba(15,23,42,.11)}form{display:grid;grid-template-columns:1fr 1fr;gap:16px}label{display:grid;gap:7px;color:#172033;font-weight:800}.wide{grid-column:1/-1}input,select,textarea{width:100%;padding:13px 14px;border:1px solid #8b96a8;border-radius:11px;background:#fff;color:#111827}textarea{min-height:190px;resize:vertical}.consent{grid-column:1/-1;display:flex;align-items:flex-start;gap:10px;font-weight:500;line-height:1.55}.consent input{width:auto;margin-top:5px}.honeypot{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}.contact-actions{grid-column:1/-1;display:flex;align-items:center;gap:16px;flex-wrap:wrap}.contact-actions button{min-height:46px;padding:11px 20px;border:1px solid #8c641f;border-radius:999px;background:#8c641f;color:#fff;font-weight:900;cursor:pointer}.contact-actions button:disabled{opacity:.55;cursor:wait}.contact-status{color:#526071}.contact-status.success{color:#166534;font-weight:800}.contact-status.error{color:#b42318;font-weight:800}.contact-status.pending{color:#8c641f}.privacy-note{margin-top:20px;padding:16px 18px;border-left:4px solid #b88a2f;border-radius:10px;background:#f7f4ec;color:#344054;line-height:1.6}@media(max-width:700px){.contact-main{padding-top:34px}.contact-hero{grid-template-columns:1fr;text-align:center}.contact-logo{width:115px;height:120px;margin:auto}.contact-hero p{margin-inline:auto}form{grid-template-columns:1fr}.wide,.consent,.contact-actions{grid-column:1}}</style>
