{
  "version": 1,
  "policy": {
    "truthStandard": "Evidence/Truth",
    "timestampBumpDoesNotCountAsRefresh": true,
    "healthyRequiresObservedOutput": true,
    "staleAfterCadenceMultiplier": 1.0,
    "rootCauseEscalationAfterCadenceMultiplier": 2.0,
    "rootCauseEscalationAfterMissedCycles": 2,
    "allowedStates": ["FRESH", "STALE", "DEGRADED", "BLOCKED", "UNKNOWN"],
    "indexedRequiresExternalEvidence": true,
    "blindRerunAllowed": false
  },
  "producerClasses": [
