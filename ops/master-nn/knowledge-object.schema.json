{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnk-asg.hr/schemas/master-nn/knowledge-object.schema.json",
  "title": "MASTER NN Knowledge Object",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","version","state","domain","projectScope","provenance","trustScore","confidence","riskClass","applicableTaskClasses","evaluator","ttl","allowedConsumerClasses","rollbackTarget"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "version": {"type":"integer","minimum":1},
    "state": {"enum":["OBSERVED","CANDIDATE","SANDBOX_VERIFIED","SHADOW_VERIFIED","DOMAIN_VERIFIED","GLOBAL_VERIFIED","QUARANTINED","REJECTED","DEPRECATED"]},
    "domain": {"type":"string","minLength":1},
    "projectScope": {"type":"array","items":{"type":"integer","minimum":1,"maximum":23},"minItems":1,"uniqueItems":true},
    "provenance": {
      "type":"object",
      "additionalProperties": false,
      "required":["sourceType","sourceRef","observedAt"],
      "properties": {
        "sourceType":{"enum":["repository","test","sandbox","shadow","public-source","authorized-external"]},
        "sourceRef":{"type":"string","minLength":1},
        "observedAt":{"type":"string","format":"date-time"}
      }
    },
    "trustScore":{"type":"number","minimum":0,"maximum":1},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "riskClass":{"enum":["R0","R1","R2","R3"]},
    "applicableTaskClasses":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
    "evaluator": {
      "type":"object",
      "additionalProperties": false,
      "required":["status","evidenceRefs"],
      "properties": {
        "status":{"enum":["pending","pass","fail","quarantine"]},
        "evidenceRefs":{"type":"array","items":{"type":"string"}}
      }
    },
    "reuseEvidence":{"type":"array","items":{"type":"string"}},
    "contradictions":{"type":"array","items":{"type":"string"}},
    "ttl":{"type":"string","minLength":1},
    "allowedConsumerClasses":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
    "rollbackTarget":{"type":"string","minLength":1},
    "containsSecrets":{"const":false},
    "containsPII":{"const":false}
  }
}
