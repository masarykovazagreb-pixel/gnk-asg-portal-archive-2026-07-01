    "rate_limit_required": true,
    "redaction_required": true,
    "audit_log_required": true,
    "kill_switch_required": true,
    "secrets_in_manifest_forbidden": true,
    "private_or_leaked_sources_forbidden": true,
    "owner_gate_for_live_connect": true
  },
  "trust_tiers": {
    "T1": "official public primary source",
    "T2": "official public partner or intergovernmental source",
    "T3": "reputable open-source research source requiring corroboration",
    "REJECT": "unauthorized, private, leaked, stolen, secret, credentialed-without-approval, or provenance-unknown source"
  },
