# Predlozak. Kopiraj u secrets.local.env i upisi vrijednosti.
# secrets.local.env je u .gitignore i NIKAD se ne commita.

# --- blog ---
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

# --- cloudflare ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- operator: JEDNA vrijednost pod tri imena ---
# Nije kljuc koji netko izdaje, nego zajednicka lozinka izmedju GitHuba i
# Workera. Mora biti identicna na sve cetiri strane (dva repozitorija + Worker).
GNK_ASG_ADMIN_TOKEN=
GNK_ASG_OPERATOR_TOKEN=
OPERATOR_TOKEN=

# --- zrcaljenje na drugi racun ---
MASARYKOVA_MIRROR_TOKEN=
MASARYKOVA_BACKUP_TOKEN=

# --- samo Cloudflare Worker, ne ide u GitHub ---
OPENAI_API_KEY=
