{
  "version": "1.0.0",
  "mode": "PREP_ONLY",
  "connected_sources": 0,
  "policy": {
    "allowed": ["public", "open", "explicitly_authorized"],
    "forbidden": ["secret", "classified", "leaked", "stolen", "credential-bypassed", "private_without_authorization"],
    "owner_gate_required_for_connect": true,
    "external_input_trust": "untrusted_by_default",
    "production_write_from_external_input": false
  },
  "required_connection_manifest_fields": [
    "source_name",
    "category",
    "access_status",
    "endpoint_type",
    "auth_model",
    "schema_mapping",
    "polling_or_webhook",
    "rate_limit",
    "retention_class",
    "allowed_use",
    "prohibited_use",
    "owner_gated",
    "sandbox_plan",
    "kill_switch",
    "acceptance_criteria",
    "evidence_requirement"
  ],
  "pipeline": [
    "ingest_sandbox",
    "normalize",
    "provenance_capture",
    "trust_score",
    "redaction",
    "deduplicate",
    "freshness_check",
    "contradiction_check",
    "prompt_injection_and_poisoning_screen",
    "shadow_evaluation",
    "human_owner_gate_if_connection_or_high_risk",
    "promote_or_quarantine"
  ],
