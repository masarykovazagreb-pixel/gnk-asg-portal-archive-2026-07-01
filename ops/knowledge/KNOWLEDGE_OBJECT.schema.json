{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnk-asg.hr/schemas/knowledge-object.schema.json",
  "title": "MASTER ASG Verified Knowledge Object",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "state", "source", "provenance", "observed_at", "domain", "project_scope", "task_classes", "risk_class", "confidence", "trust_score", "evaluator", "ttl", "consumer_classes", "rollback_target"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{6,160}$"},
    "version": {"type": "string"},
    "state": {"enum": ["OBSERVED", "CANDIDATE", "SANDBOX_VERIFIED", "SHADOW_VERIFIED", "DOMAIN_VERIFIED", "GLOBAL_VERIFIED", "QUARANTINED", "REJECTED", "DEPRECATED"]},
    "source": {"type": "string", "minLength": 2},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "hash_or_evidence"],
      "properties": {
        "kind": {"enum": ["INTERNAL_RESULT", "PUBLIC_SOURCE", "AUTHORIZED_EXTERNAL", "BENCHMARK", "TEST", "OTHER"]},
        "reference": {"type": "string"},
        "hash_or_evidence": {"type": "string"}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "domain": {"type": "string"},
    "project_scope": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "task_classes": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "risk_class": {"enum": ["R0", "R1", "R2", "R3"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "trust_score": {"type": "number", "minimum": 0, "maximum": 1},
    "contradictions": {"type": "array", "items": {"type": "string"}, "default": []},
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["PENDING", "PASS", "FAIL", "QUARANTINE"]},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reuse_evidence": {"type": "array", "items": {"type": "string"}, "default": []},
    "ttl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "expires_at"],
      "properties": {
        "policy": {"enum": ["FIXED", "REFRESH_ON_USE", "MANUAL_REVIEW", "NON_EXPIRING_WITH_REVALIDATION"]},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "consumer_classes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "rollback_target": {"type": ["string", "null"]},
    "failure_lessons": {"type": "array", "items": {"type": "string"}, "default": []},
    "transfer_score": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "relevance": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "recency": {"type": "number", "minimum": 0, "maximum": 1},
        "success_history": {"type": "number", "minimum": 0, "maximum": 1},
        "risk_penalty": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
