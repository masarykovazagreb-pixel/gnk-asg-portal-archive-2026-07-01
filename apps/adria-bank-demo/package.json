{
  "name": "adria-bank-demo",
  "version": "1.2.0",
  "private": true,
  "description": "Synthetic banking rehearsal with local background simulation and public daily reference data",
  "author": "Adria Bank Demo Team",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "electron .",
    "install:windows:source": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\Install-Windows.ps1",
    "test": "node --test tests/*.test.mjs",
    "package:desktop-zip": "python scripts/package-desktop-zip.py",
    "package:windows-installer-zip": "python scripts/package-windows-installer.py",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "20.14.6"
  },
  "build": {
    "appId": "hr.adria.demo.bank",
    "productName": "Adria Bank Demo",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "welcome.html",
      "client.html",
      "exchange.html",
      "README.md",
      "COMPLIANCE-OVERVIEW.md",
      "PRODUCT-AND-COMPETITOR-REVIEW-2026-10-11.md",
      "src/**/*",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/adria.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Adria-Banka-Demo-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Adria Bank Demo",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Adria-Banka-Demo-Portable-${version}-${arch}.${ext}"
    }
  }
}
