{
  "version": "GNK_ASG_AUTO_PUBLICATION_POLICY_V2_20260710_MIN_10_NEWS_DAILY",
  "mode": "controlled_portal_auto_publication",
  "scope": {
    "portalPosts": true,
    "newsroomNews": true,
    "email": false,
    "campaigns": false,
    "socialMediaAutoPost": false,
    "externalSyndication": false
  },
  "globalRules": {
    "sourceAllowlistRequired": true,
    "imageHotlinking": false,
    "fallbackImage": "/assets/gnk-gold-logo.svg",
    "copyFullArticleText": false,
    "originalSummaryRequired": true,
    "sourceAttributionRequired": true,
    "manualReviewForLegalClaims": true,
    "manualReviewForFinancialClaims": true,
    "manualReviewForPersonalData": true,
    "protectedDataExcluded": true,
    "duplicateWindowHours": 36,
    "maxSummaryLengthChars": 520
  },
  "cadence": {
    "timezone": "Europe/Zagreb",
    "windows": ["07:30", "09:30", "11:30", "14:30", "16:30", "19:30"],
    "minAutoPostsPerDay": 10,
    "targetAutoPostsPerDay": 12,
    "maxAutoPostsPerDay": 18,
    "minPostsPerWindow": 1,
    "targetPostsPerWindow": 2,
    "maxPostsPerWindow": 4,
    "maxAutoPostsPerSourcePerDay": 2
  },
  "priorityMix": [
    {"category":"source-summary-business","dailyTarget":3},
    {"category":"source-summary-markets","dailyTarget":2},
    {"category":"source-summary-technology","dailyTarget":2},
    {"category":"source-summary-fintech","dailyTarget":2},
    {"category":"source-summary-crypto","dailyTarget":1},
    {"category":"official-update","dailyTarget":1},
    {"category":"project-operations-update","dailyTarget":1}
  ],
  "categories": [
    {
      "id": "official-update",
      "label": "Official update",
      "autoPublishAllowed": true,
      "requiresAdminApproval": false,
      "source": "internal-approved-template",
      "imageMode": "fallback_or_internal"
    },
    {
      "id": "project-operations-update",
      "label": "Project operations update",
      "autoPublishAllowed": true,
      "requiresAdminApproval": false,
      "source": "project-daily-finance-analysis-public-schema",
      "imageMode": "fallback_or_internal",
      "guard": "No private finance, no bank data, no personal data."
    },
    {
      "id": "source-summary-business",
      "label": "Business source summary",
      "autoPublishAllowed": true,
      "requiresAdminApproval": false,
      "source": "news-sources-allowlist",
      "imageMode": "fallback_by_default"
    },
    {
      "id": "source-summary-markets",
      "label": "Markets source summary",
      "autoPublishAllowed": true,
      "requiresAdminApproval": false,
      "source": "news-sources-allowlist",
      "imageMode": "fallback_by_default"
    },
    {
      "id": "source-summary-technology",
      "label": "Technology source summary",
      "autoPublishAllowed": true,
      "requiresAdminApproval": false,
      "source": "news-sources-allowlist",
      "imageMode": "fallback_by_default"
    },
    {
      "id": "source-summary-fintech",
      "label": "Fintech source summary",
      "autoPublishAllowed": true,
      "requiresAdminApproval": false,
      "source": "news-sources-allowlist",
      "imageMode": "fallback_by_default"
    },
    {
      "id": "source-summary-crypto",
      "label": "Crypto source summary",
      "autoPublishAllowed": true,
      "requiresAdminApproval": false,
      "source": "news-sources-allowlist",
      "imageMode": "fallback_by_default"
