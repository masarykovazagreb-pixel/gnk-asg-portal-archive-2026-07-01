{
  "version": "GNK_ASG_WORKFLOW_TASKS_V1_20260710",
  "mode": "staging_only_no_automatic_publication",
  "rules": {
    "noBulkMail": true,
    "noCampaigns": true,
    "noAutomaticPublication": true,
    "adminApprovalRequired": true,
    "publicOnlyBeforeApproval": false,
    "protectedDataExcluded": true
  },
  "workflows": [
    {
      "id": "wf-01-media-registration",
      "name": "Media registration workflow",
      "owner": "Media Relations",
      "trigger": "Public media user creates username/password and submits application.",
      "steps": [
        "Public user registers account",
        "Public user saves draft",
        "Public user submits application",
        "Admin reviews application",
        "Admin marks approved/rejected/needs-info",
        "Approved user may later add travel/document details"
      ],
      "guards": ["media user is not admin", "submit is not approval", "admin endpoint requires operator/auth session"]
    },
    {
      "id": "wf-02-newsroom-sources",
      "name": "Newsroom source workflow",
      "owner": "Newsroom Desk",
      "trigger": "Scheduled editorial review or manual source check.",
      "steps": [
        "Read allowlist from /data/news-sources.json",
        "Collect title, URL, source, category and timestamp",
        "Write original short summary",
        "Check image rights",
        "Use fallback visual unless image reuse is explicitly allowed",
        "Save as draft for admin/editor approval"
      ],
      "guards": ["no full-text copying", "no hotlinking", "no paywalled image reuse", "legal/financial claims require manual review"]
    },
    {
      "id": "wf-03-publication-staging",
      "name": "Publication staging workflow",
      "owner": "Editorial Operations",
      "trigger": "Prepared announcement, source summary, finance update or THE CODE update.",
      "steps": [
        "Create draft object",
        "Classify as official/source-summary/finance/project/update",
        "Attach source policy and image policy",
        "Mark status as draft",
        "Wait for admin approval",
        "Only after approval move to publish queue"
      ],
      "guards": ["draft does not publish", "publish queue is not campaign mail", "manual approval only"]
    },
    {
      "id": "wf-04-project-daily-finance",
      "name": "Project daily finance workflow",
      "owner": "Finance Desk",
      "trigger": "Daily public operating review.",
      "steps": [
        "Read project finance schema",
        "Collect traffic, leads, applications and risk signals",
        "Update public signal only",
        "Exclude private ledgers, bank data, personal data and raw e-mail",
        "Save daily summary draft",
        "Admin/finance approval before public display"
      ],
      "guards": ["public signal only", "no private finance ledger", "no personal data"]
    },
    {
      "id": "wf-05-mail-studio-guard",
      "name": "Mail Studio guard workflow",
      "owner": "Protected Operations",
      "trigger": "Manual individual communication request.",
      "steps": [
        "Require authenticated admin/operator session",
        "Create or review individual draft",
        "Block campaign/bulk actions",
        "Require manual send confirmation",
        "Log reference code"
      ],
      "guards": ["Mail Studio behind auth", "no bulk mail", "no automatic campaign"]
    },
    {
      "id": "wf-06-safe-deploy",
      "name": "Safe deploy workflow",
      "owner": "Deployment",
      "trigger": "Explicit user command only.",
      "steps": [
        "Merge approved PR",
        "Run safe deploy workflow only when explicitly ordered",
        "Use confirm input DEPLOY_PUBLIC_PORTAL_SAFE",
        "Verify public routes",
        "Verify protected admin remains protected",
        "Disable Actions again if required"
      ],
      "guards": ["no deploy without explicit order", "no DNS changes", "no Cloudflare route changes", "no secret changes"]
    }
  ]
}
