{
  "version": "2026-07-04.autonomy.2",
  "status": "review-only",
  "timezone": "Europe/Zagreb",
  "dailyReview": {
    "packageTime": "08:00",
    "rejectionDeadline": "09:00",
    "windowMinutes": 60,
    "silentAcceptanceEnabled": true,
    "silentAcceptanceMeaning": "Every unchanged item explicitly delivered in the 08:00 daily package is confirmed by Nermin Sefić if no rejection or hold is recorded by 09:00 Europe/Zagreb.",
    "confirmationScope": [
      "publication approval",
      "Nermin Sefić authorship when displayed in the package",
      "Nermin Sefić article-specific editor or reviewer credit when displayed in the package",
      "automatic public release after the deadline"
    ],
    "notificationRequired": true,
    "notificationFailureBlocksSilentAcceptance": true,
    "itemChangeAfterPackageBlocksSilentAcceptance": true,
    "missedRunCatchUp": true
  },
  "operatingTarget": {
    "autonomousPercent": 99,
    "escalationPercent": 1,
    "note": "The daily package is the Executive Office control point. Items omitted from that package are not approved by silence."
  },
  "packageEligibility": {
    "publicationTypes": ["desk-article", "nermin-original", "nermin-commentary"],
    "required": [
      "title",
      "slug",
      "summary",
      "body",
      "canonical",
      "image",
      "imageAlt",
      "primarySource",
      "factCheckComplete",
      "sourceReviewComplete"
    ],
    "minimumSupportingSources": 1,
    "unresolvedErrorsAllowed": 0,
    "automaticPublicationAfterDeadline": true
  },
  "prePackageValidation": {
    "factsAndSourcesMustBeComplete": true,
    "financialClaimsMustIdentifySourcePeriodAndStatus": true,
    "projectionsMustBeLabelledAsProjections": true,
    "legalClaimsMustIdentifySourceAndJurisdiction": true,
    "attributionMustBeVisibleInPackage": true,
    "contentHashMustBeFrozenAtPackageTime": true
  },
  "attribution": {
    "defaultAuthor": "GNK DINAMO Ltd. Group Editorial Desk",
    "executiveEditor": "Nermin Sefić",
    "dailyPackageCanConfirmPersonalAuthorship": true,
    "dailyPackageCanConfirmArticleSpecificReview": true,
    "confirmationMethod": "No rejection or hold by 09:00 for the unchanged item delivered at 08:00"
  },
  "decisionStates": [
    "preparing",
    "awaiting-rejection-window",
    "rejected",
    "held-for-review",
    "confirmed-by-deadline",
    "published",
    "publication-failed"
  ],
  "hardLocks": {
    "productionDeployWithoutToken": false,
    "dnsChanges": false,
    "secretChanges": false,
    "campaignEmail": false,
    "massEmail": false
  }
}
