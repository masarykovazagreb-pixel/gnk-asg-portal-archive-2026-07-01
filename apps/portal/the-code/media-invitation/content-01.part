:root{--navy:#06162b;--blue:#0b2445;--gold:#d2ad64;--pale:#f5efe3;--ink:#19243a;--muted:#5d697c}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#edf1f6;color:var(--ink);font-family:Arial,Helvetica,sans-serif;line-height:1.62}.top{position:sticky;top:0;z-index:5;background:rgba(6,22,43,.96);border-bottom:1px solid var(--gold);padding:10px 16px;text-align:center}.top a{color:#fff;text-decoration:none;font-size:12px;font-weight:800;letter-spacing:.05em;margin:0 10px}.top a:nth-child(2){color:#e4c98f}.hero{background:radial-gradient(circle at 80% 20%,#173b68 0,transparent 38%),linear-gradient(135deg,#040d1c,#0b2445);color:#fff;padding:74px 22px 58px;border-bottom:5px solid var(--gold)}.wrap{width:min(1080px,100%);margin:auto}.eyebrow{color:#e4c98f;font-weight:800;font-size:12px;letter-spacing:.18em;text-transform:uppercase}.hero h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(54px,10vw,112px);line-height:.92;margin:18px 0}.hero h2{max-width:900px;font-size:clamp(22px,4vw,42px);line-height:1.1;margin:0 0 22px}.hero p{max-width:780px;color:#d8e4f4;font-size:18px}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:13px 22px;border-radius:999px;border:1px solid #fff;color:#fff;text-decoration:none;font-weight:900;font-size:13px;letter-spacing:.03em}.btn.gold{background:var(--gold);border-color:var(--gold);color:var(--navy)}.btn.light{background:#fff;border-color:#fff;color:#8a611a}.section{padding:46px 22px}.section.white{background:#fff}.section.dark{background:var(--navy);color:#fff}.section h2{font-family:Georgia,'Times New Roman',serif;font-size:clamp(30px,5vw,52px);line-height:1.08;margin:7px 0 18px}.lead{font-size:18px;max-width:900px}.quote{margin:28px 0;padding:24px;border-left:5px solid var(--gold);background:var(--navy);color:#fff;font-size:18px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:26px}.card{background:#fff;border:1px solid #dbe1e9;border-radius:16px;padding:22px}.dark .card{background:#0b2445;border-color:#284467}.card strong{display:block;color:#9a6d20;font-size:24px}.dark .card strong{color:#e4c98f}.card small{color:var(--muted)}.dark .card small{color:#c6d3e5}.steps{display:grid;gap:12px;margin-top:24px}.step{display:grid;grid-template-columns:52px 1fr;gap:14px;align-items:start;background: