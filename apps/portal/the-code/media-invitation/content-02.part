:#fff;border:1px solid #dbe1e9;border-radius:14px;padding:18px}.num{width:42px;height:42px;border-radius:50%;background:var(--gold);color:var(--navy);font-weight:900;display:grid;place-items:center}.programme{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.day{background:#fff;border-top:4px solid var(--gold);border-radius:12px;padding:20px;color:var(--ink)}.day h3{margin:0 0 10px;color:var(--navy)}.notice{background:#f7f2e7;border-left:5px solid var(--gold);padding:20px;margin:22px 0}.footer{background:#030b17;color:#aebbd0;padding:28px 22px;text-align:center;font-size:13px}.footer a{color:#e4c98f}.testbar{background:#fff;border:1px solid #d7dee8;border-radius:16px;padding:20px;margin-top:24px}.testbar b{color:var(--navy)}@media(max-width:760px){.grid,.programme{grid-template-columns:1fr}.hero{padding-top:54px}.top a{display:inline-block;margin:3px 6px}.section{padding:36px 16px}.actions{display:grid}.btn{width:100%}}
</style>
</head>
