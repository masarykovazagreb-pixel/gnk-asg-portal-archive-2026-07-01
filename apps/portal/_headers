# Pravila kesiranja za javni portal.
#
# Razlog: stranica /gnk-aktual/ se mijenja cesto (novi izvori, drugaciji
# raspored, novi tajmeri rotacije), a HTML se do sada kesirao na rubu i u
# pregledniku pa su korisnici jos danima gledali staru verziju stranice —
# ukljucujuci stare blokove kategorija koji vise ne postoje.
#
# HTML i podaci se uvijek provjeravaju kod izvora (jeftin 304 ako nema
# promjene). Statika s verzijom u imenu ostaje dugo kesirana.

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/gnk-aktual/*
  Cache-Control: public, max-age=0, must-revalidate

/en/gnk-aktual/*
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: public, max-age=0, must-revalidate

# Restoranske stranice se mijenjaju, pa se HTML uvijek provjerava kod izvora.
# Slike i stilovi nose verziju u upitu, pa smiju stajati dugo u kesu.
/restaurants/*
  Cache-Control: public, max-age=0, must-revalidate

/restaurants/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# Paketi za razvoj: uvijek se provjeravaju kod izvora, jer se mijenjaju.
/preuzimanja/*
  Cache-Control: public, max-age=0, must-revalidate

# Mobilna aplikacija. Manifest mora nositi svoj MIME tip, inace ga Chrome ne
# prihvaca i ne nudi instalaciju. Servisni radnik se ne smije kesirati, jer
# inace uredaj zauvijek ostaje na staroj inacici aplikacije.
/app/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=0, must-revalidate

/app/sw.js
  Content-Type: application/javascript
  Cache-Control: no-cache

/app/index.html
  Cache-Control: public, max-age=0, must-revalidate

/app/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Animacija i njezina glazba: velike datoteke koje se ne mijenjaju.
/animacija/uploads/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# GNK ASG Developer Tools: strogi CSP i zabrana ugradnje u tuđe frameove.
/developer-tools/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; form-action 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# GNK ASG data-clinic: strogi CSP, zabrana ugradnje u tuđe frameove.
/data-clinic/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; form-action 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# GNK ASG metodologije: strogi CSP, zabrana ugradnje u tuđe frameove.
/metodologije/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# GNK ASG status: strogi CSP, zabrana ugradnje u tuđe frameove.
/status/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
