  "selection": {"formulaInputs": ["quality","freshness","reliability","latency","cost","healthHistoryPenalty"], "testOrMockProviderProductionReady": false},
  "singleWriter": {"authoritativeStateWriterRequired": true, "eventProducersMayBeParallel": true, "stateToMainWritesSerialized": true, "exactShaImmediatelyBeforeWrite": true},
