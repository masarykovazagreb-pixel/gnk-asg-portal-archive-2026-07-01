{
  "version": "MASTER_ASG_WORKER_FLEET_V1.2",
  "architect": "Nermin Sefic",
  "mode": "controlled-autonomy",
  "designSources": [
    "cporter202/agentic-ai-starters: multi-agent-ops and MCP toolchain patterns",
    "cporter202/agentic-ai-apis: provider/API/MCP discovery catalog",
    "cporter202/ai-agent-tools: capability discovery and tool-adapter patterns"
  ],
  "governance": {
    "humanPrincipal": "Nermin Sefic",
    "humanRole": "architect-owner-final-veto",
    "executiveAgent": "ceo-agent",
    "operationalOrchestrator": "master-orchestrator",
    "escalationPolicy": "CEO escalates only material business-goal changes, legal/security risk, external authorization, material cost or irreversible action",
    "decisionFlow": ["human-principal", "ceo-agent", "master-orchestrator", "specialist-workers", "reviewer-worker", "release-guardian"]
  },
  "principles": {
    "singleWriter": true,
    "exactShaRequiredForWrites": true,
    "failClosedOnUnknownState": true,
    "provenanceRequired": true,
    "noImplicitExternalAuthority": true,
    "providerSelection": "quality*freshness*reliability*latency*cost",
    "assessmentRequiresIndependentCorroboration": true,
    "contradictionSearchRequired": true,
    "leastPrivilegePerWorker": true
  },
  "riskClasses": {"R0":"read-only","R1":"analysis-only","R2":"controlled-write","R3":"deploy-or-external-side-effect"},
  "workers": [
    {"id":"ceo-agent","role":"executive-control","risk":"R2","reportsTo":"human-principal","manages":["master-orchestrator"],"capabilities":["translate-owner-intent","set-objectives","allocate-priority","resolve-cross-team-conflicts","approve-operating-plan","budget-governance","escalation-filter","portfolio-health"],"requires":["no-direct-R3-execution","material-decisions-escalate-to-human"],"fallback":"freeze-new-external-actions-and-continue-safe-read-only-operations"},
    {"id":"master-orchestrator","role":"orchestration","risk":"R2","reportsTo":"ceo-agent","capabilities":["dispatch","prioritize","dedupe","route","aggregate-health"],"requires":["exact-sha-before-write"],"fallback":"read-only-degraded"},
    {"id":"planner-worker","role":"planning","risk":"R1","reportsTo":"master-orchestrator","capabilities":["decompose-task","dependency-map","priority-score","budget-plan"],"fallback":"manual-plan"},
    {"id":"reviewer-worker","role":"review","risk":"R1","reportsTo":"master-orchestrator","capabilities":["verify-output","contradiction-check","policy-check","quality-score"],"fallback":"block-unverified"},
    {"id":"health-sentinel","role":"health-and-self-heal","risk":"R1","reportsTo":"master-orchestrator","capabilities":["heartbeat","freshness-check","provider-health","stale-detection","incident-open"],"fallback":"alert-only"},
    {"id":"provider-scout","role":"api-provider-discovery","risk":"R1","reportsTo":"master-orchestrator","capabilities":["discover-provider","score-provider","license-check","latency-benchmark","reliability-benchmark","mcp-discovery"],"fallback":"no-change"},
    {"id":"world-intel-worker","role":"osint-intelligence","risk":"R1","reportsTo":"master-orchestrator","capabilities":["incident-ingest","source-fusion","conflict-detection","military-activity-osint","sanctions","outages","protests","weather-risk","economic-risk","confidence-score"],"constraints":["public-or-authorized-sources-only","no-secret-service-claim-without-auth"],"fallback":"public-osint-only"},
    {"id":"intel-correlation-worker","role":"cross-source-correlation","risk":"R1","reportsTo":"master-orchestrator","capabilities":["entity-resolution","temporal-correlation","geospatial-correlation","duplicate-collapse","common-origin-detection","event-linking"],"requires":["provenance-preserved","no-duplicate-vote-inflation"],"fallback":"uncorrelated-evidence-bundle"},
    {"id":"intel-assessor-worker","role":"intelligence-assessment","risk":"R1","reportsTo":"master-orchestrator","capabilities":["primary-hypothesis","alternative-scenarios","confidence-calibration","indicator-watchlist","change-trigger-definition","forecast-window"],"requires":["minimum-two-independent-sources-or-explicit-low-confidence","freshness-score","source-quality-score"],"fallback":"insufficient-evidence"},
    {"id":"intel-red-team-worker","role":"adversarial-intelligence-review","risk":"R1","reportsTo":"master-orchestrator","capabilities":["disconfirming-evidence-search","alternative-explanation","source-dependence-check","confirmation-bias-check","confidence-challenge"],"requires":["independent-review-path"],"fallback":"review-required"},
    {"id":"aktual-worker","role":"news-and-aktual","risk":"R2","reportsTo":"master-orchestrator","capabilities":["news-ingest","cluster","rank","summarize","publish-draft"],"requires":["source-provenance","freshness-threshold"],"fallback":"draft-only"},
    {"id":"market-worker","role":"market-data","risk":"R1","reportsTo":"master-orchestrator","capabilities":["market-ingest","fx","digital-assets","staleness-check","provider-failover"],"fallback":"last-known-good-with-stale-flag"},
    {"id":"publication-worker","role":"publication-distribution","risk":"R2","reportsTo":"master-orchestrator","capabilities":["portal-publish","distribution-parity","canonical-check","sitemap-sync","indexability-check"],"requires":["single-writer-lock","exact-sha-before-write"],"fallback":"queue-only"},
    {"id":"seo-entity-worker","role":"seo-aeo-geo","risk":"R2","reportsTo":"master-orchestrator","capabilities":["meta","schema","canonical","hreflang","internal-links","entity-signals","image-seo"],"requires":["no-keyword-stuffing","truthful-attribution"],"fallback":"analysis-only"},
    {"id":"qa-worker","role":"quality-assurance","risk":"R1","reportsTo":"master-orchestrator","capabilities":["broken-links","hr-en-parity","mobile","accessibility","performance","contract-check"],"fallback":"report-only"},
    {"id":"release-guardian","role":"release-control","risk":"R3","reportsTo":"ceo-agent","capabilities":["exact-sha-check","single-writer-lock","smoke","rollback-readiness","deploy-gate"],"requires":["all-core-gates-green","head-sha-match"],"fallback":"block-release"},
    {"id":"security-guardian","role":"access-and-security","risk":"R2","reportsTo":"ceo-agent","capabilities":["auth-state","permission-check","webauthn-state","secret-leak-check","service-access-matrix"],"fallback":"deny-access"}
  ],
  "assessmentContract": {
    "requiredFields":["assessmentId","generatedAt","topic","primaryAssessment","confidence","confidenceRationale","sourceRefs","independentSourceCount","contradictions","alternativeScenarios","watchIndicators","whatWouldChangeAssessment","freshness","provenanceDigest"],
    "confidenceBands":{"low":"0-49","moderate":"50-69","high":"70-84","veryHigh":"85-100"},
    "rules":[
      "syndicated copies sharing one upstream origin count as one independent source",
      "single-source assessments cannot exceed moderate confidence unless source is primary and directly authoritative",
      "material contradictions reduce confidence until resolved or explicitly bounded",
      "forecast statements must include a time window and observable change triggers"
    ]
  },
  "runtime": {
    "taskStates":["queued","running","review","blocked","done","degraded"],
    "healthStates":["healthy","degraded","stale","down","quarantined"],
    "requiredTelemetry":["workerId","taskId","startedAt","finishedAt","sourceRefs","confidence","health","resultDigest","inputSha","outputSha"],
    "retryPolicy":{"maxAutomaticRetries":2,"backoff":"exponential","afterExhaustion":"quarantine-or-human-review"}
  }
}